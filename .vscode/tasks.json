{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Build FreeGLUT",
            "type": "process",

            "command": "C:/msys64/ucrt64/bin/g++.exe",

            "args": [
                "-g",
                "${file}",

                "-I",
                "C:/msys64/ucrt64/include",

                "-L",
                "C:/msys64/ucrt64/lib",

                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-lgdi32",

                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],

            "options": {
                "cwd": "${fileDirname}"
            },

            "problemMatcher": [
                "$gcc"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}